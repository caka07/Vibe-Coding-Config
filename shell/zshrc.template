# Vibe Coding common zshrc

export HOMEBREW_PREFIX="${HOMEBREW_PREFIX:-${HOMEBREW_PREFIX}}"
export ANACONDA_PREFIX="${ANACONDA_PREFIX:-${HOMEBREW_PREFIX}/anaconda3}"

if [ -x "${HOMEBREW_PREFIX}/bin/brew" ]; then
  eval "$("${HOMEBREW_PREFIX}/bin/brew" shellenv)"
fi

if [ -f "${ANACONDA_PREFIX}/etc/profile.d/conda.sh" ]; then
  . "${ANACONDA_PREFIX}/etc/profile.d/conda.sh"
fi

export PATH="${HOME}/.local/bin:${PATH}"

# AI coding aliases
alias yolo='claude --dangerously-skip-permissions'
alias codexfull='codex --sandbox danger-full-access --ask-for-approval on-request'

# Modern CLI stack
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi

if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
fi

if command -v atuin >/dev/null 2>&1; then
  eval "$(atuin init zsh)"
fi

if command -v fzf >/dev/null 2>&1; then
  source <(fzf --zsh)
fi

export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
export FZF_CTRL_T_COMMAND="${FZF_DEFAULT_COMMAND}"
export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'
export FZF_DEFAULT_OPTS="
  --height 60% --layout=reverse --border=rounded --margin=1 --padding=1
  --prompt='  ' --pointer='>' --marker='*'
  --color=bg+:#E5DECB,fg:#141413,fg+:#141413,hl:#C24A2E,hl+:#C24A2E
  --color=info:#8A857A,border:#D97757,prompt:#D97757,pointer:#D97757,marker:#5F7F4B,header:#8A857A,spinner:#D97757"
export FZF_CTRL_T_OPTS="--preview 'bat --color=always --style=numbers --line-range=:200 {}'"
export FZF_ALT_C_OPTS="--preview 'eza --tree --level=2 --color=always --icons {}'"

alias ls='eza --group-directories-first --icons'
alias ll='eza -lah --group-directories-first --icons --git'
alias la='eza -a --group-directories-first --icons'
alias lt='eza --tree --level=2 --icons'
alias cat='bat'

export RIPGREP_CONFIG_PATH="${HOME}/.config/ripgrep/ripgreprc"

HISTFILE="${HOME}/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000
setopt SHARE_HISTORY
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_REDUCE_BLANKS
setopt HIST_VERIFY
setopt EXTENDED_HISTORY
setopt INC_APPEND_HISTORY
setopt AUTO_CD
setopt INTERACTIVE_COMMENTS

if [ -e "${HOME}/.iterm2_shell_integration.zsh" ]; then
  source "${HOME}/.iterm2_shell_integration.zsh"
fi

if [ -f "${HOMEBREW_PREFIX}/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]; then
  source "${HOMEBREW_PREFIX}/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
  ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#A8A29A'
  ZSH_AUTOSUGGEST_STRATEGY=(history completion)
fi

if [ -f "${HOMEBREW_PREFIX}/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]; then
  source "${HOMEBREW_PREFIX}/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi

